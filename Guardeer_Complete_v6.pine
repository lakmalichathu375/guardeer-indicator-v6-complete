// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 10: CORE DATA TYPES (UDT)
// ═══════════════════════════════════════════════════════════════════════════════════

type bar_data
    float o = open
    float c = close
    float h = high
    float l = low
    float v = volume
    int n = bar_index
    int t = time

type market_structure
    float[] prices
    int[] indices
    float[] levels

type order_block
    float[] tops
    float[] bottoms
    int[] lefts
    float[] averages
    float[] volumes
    int[] directions

type fvg_data
    box[] boxes
    line[] lines
    bool bullish
    float top_level
    float bottom_level
    int left_idx
    int right_idx

type pattern_data
    string found = "None"
    bool detected = false
    int period = 0
    bool is_bullish = false

type trade_alert
    bool bullish_bos = false
    bool bullish_choch = false
    bool bullish_chochplus = false
    bool bearish_bos = false
    bool bearish_choch = false
    bool bearish_chochplus = false
    bool equal_high = false
    bool equal_low = false
    bool fvg_signal = false
    bool ob_signal = false
    bool zone_signal = false

type risk_reward
    float entry = 0.0
    float stop_loss = 0.0
    float take_profit = 0.0
    float risk_per_unit = 0.0
    float reward_per_unit = 0.0
    float rr_ratio = 0.0
    float position_size = 0.0
    float risk_amount = 0.0
    bool is_long = false
    bool is_valid = false

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 11: GLOBAL VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════════

var bar_data b = bar_data.new()
var pattern_data p = pattern_data.new()
var trade_alert blalert = trade_alert.new()
var trade_alert bralert = trade_alert.new()
var array<line> msline = array.new<line>()
var int iLen = internal_r_lookback
var int sLen = swing_r_lookback

invcol = color.new(color.white, 100)

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 12: HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════════

f_zscore(float src, int lookback) =>
    avg = ta.sma(src, lookback)
    std = ta.stdev(src, lookback)
    std != 0 ? (src - avg) / std : 0

f_dark_color(color css, float factor, bool is_bullish) =>
    blue  = color.b(css) * (1 - factor)
    red   = color.r(css) * (1 - factor)
    green = color.g(css) * (1 - factor)
    color.rgb(int(red), int(green), int(blue), 0)

f_line_style(string style_input) =>
    switch style_input
        "⎯⎯⎯" => line.style_solid
        "----" => line.style_dashed
        "····" => line.style_dotted
        => line.style_solid

f_calc_smma(float src, int len) =>
    var float smma = na
    smma := na(smma) ? ta.sma(src, len) : (smma[1] * (len - 1) + src) / len
    smma

f_calc_zlema(float src, int len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    d = ema1 - ema2
    ema1 + d

f_check_impulse(int impulse_length, int impulse_strength) =>
    hi = f_calc_smma(high, impulse_length)
    lo = f_calc_smma(low, impulse_length)
    mi = f_calc_zlema(hlc3, impulse_length)
    
    md = (mi > hi) ? (mi - hi) : (mi < lo) ? (mi - lo) : 0
    md_prev = (mi[1] > hi[1]) ? (mi[1] - hi[1]) : (mi[1] < lo[1]) ? (mi[1] - lo[1]) : 0
    
    sb = ta.sma(md, impulse_strength)
    sb_prev = ta.sma(md_prev, impulse_strength)
    
    sh = md - sb
    sh_prev = md_prev - sb_prev
    
    sh != 0 and sh_prev != 0

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 13: MARKET STRUCTURE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════

// Dynamic lookback
if ms_mode == "Dynamic"
    vv = f_zscore(((close - close[iLen]) / close[iLen]) * 100, iLen)
    switch
        vv >= 2.0 or vv <= -2.0 => iLen := 5
        vv >= 1.9 or vv <= -1.9 => iLen := 6
        vv >= 1.8 or vv <= -1.8 => iLen := 7
        vv >= 1.7 or vv <= -1.7 => iLen := 8
        vv >= 1.6 or vv <= -1.6 => iLen := 9
        vv >= 1.5 or vv <= -1.5 => iLen := 10
        => iLen

// Pivot detection
iH = ta.pivothigh(high, iLen, iLen)
sH = ta.pivothigh(high, sLen, sLen)
iL = ta.pivotlow(low, iLen, iLen)
sL = ta.pivotlow(low, sLen, sLen)

// Candle color
switch
    close > open => boolean.set(green_candle, true)
    close < open => boolean.set(red_candle, true)

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 14: RISK-REWARD CALCULATOR FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════════

f_calculate_risk_reward(float entry, float sl, float tp, float acc_size, float risk_pct) =>
    result = risk_reward.new()
    
    if entry == 0 or sl == 0 or tp == 0
        result.is_valid := false
        return result
    
    result.entry := entry
    result.stop_loss := sl
    result.take_profit := tp
    result.is_long := tp > entry
    
    result.risk_per_unit := math.abs(entry - sl)
    result.reward_per_unit := math.abs(tp - entry)
    
    if result.risk_per_unit == 0
        result.is_valid := false
        return result
    
    result.rr_ratio := result.reward_per_unit / result.risk_per_unit
    result.risk_amount := acc_size * (risk_pct / 100)
    result.position_size := result.risk_amount / result.risk_per_unit
    
    result.is_valid := true
    result

f_draw_rr_lines() =>
    if entryPrice_rr == 0 or slPrice_rr == 0 or tpPrice_rr == 0
        return
    
    var line entry_line = na
    var line sl_line = na
    var line tp_line = na
    var label entry_label = na
    var label sl_label = na
    var label tp_label = na
    
    if barstate.islast
        line.delete(entry_line)
        line.delete(sl_line)
        line.delete(tp_line)
        label.delete(entry_label)
        label.delete(sl_label)
        label.delete(tp_label)
        
        x1 = bar_index - 40
        x2 = bar_index + 10
        
        entry_line := line.new(x1, entryPrice_rr, x2, entryPrice_rr, color=color.yellow, width=2, style=line.style_solid, extend=extend.right)
        sl_line := line.new(x1, slPrice_rr, x2, slPrice_rr, color=color.red, width=2, style=line.style_dashed, extend=extend.right)
        tp_line := line.new(x1, tpPrice_rr, x2, tpPrice_rr, color=color.green, width=2, style=line.style_dashed, extend=extend.right)
        
        entry_label := label.new(x2, entryPrice_rr, "Entry: " + str.tostring(entryPrice_rr, format.mintick), style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.small)
        sl_label := label.new(x2, slPrice_rr, "SL: " + str.tostring(slPrice_rr, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
        tp_label := label.new(x2, tpPrice_rr, "TP: " + str.tostring(tpPrice_rr, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 15: MTF SCANNER
// ═══════════════════════════════════════════════════════════════════════════════════

f_get_candle_values() =>
    current = ta.ema(ema_src, ema_length)
    previous = current[1]
    impulse = f_check_impulse(34, 9)
    [current, previous, impulse]

f_get_trend_indicator(float current, float previous, bool impulse) =>
    if not impulse
        return neutraltrend_ind
    current > previous ? uptrend_indicator : current < previous ? downtrend_indicator : neutraltrend_ind

// MTF Data Requests
[curr_1m, prev_1m, imp_1m] = request.security(syminfo.tickerid, "1", f_get_candle_values())
[curr_3m, prev_3m, imp_3m] = request.security(syminfo.tickerid, "3", f_get_candle_values())
[curr_5m, prev_5m, imp_5m] = request.security(syminfo.tickerid, "5", f_get_candle_values())
[curr_15m, prev_15m, imp_15m] = request.security(syminfo.tickerid, "15", f_get_candle_values())
[curr_1h, prev_1h, imp_1h] = request.security(syminfo.tickerid, "60", f_get_candle_values())
[curr_4h, prev_4h, imp_4h] = request.security(syminfo.tickerid, "240", f_get_candle_values())
[curr_D, prev_D, imp_D] = request.security(syminfo.tickerid, "D", f_get_candle_values())

// ═══════════════════════════════════════════════════════════════════════════════════
