        row += 1
    
    if show_4h
        table.cell(mtf_table, 0, row, "4h", text_color=text_color_mtf, text_size=table_txt_size)
        table.cell(mtf_table, 1, row, f_get_trend_indicator(curr_4h, prev_4h, imp_4h), text_color=text_color_mtf, text_size=table_txt_size)
        row += 1
    
    if show_D
        table.cell(mtf_table, 0, row, "1D", text_color=text_color_mtf, text_size=table_txt_size)
        table.cell(mtf_table, 1, row, f_get_trend_indicator(curr_D, prev_D, imp_D), text_color=text_color_mtf, text_size=table_txt_size)
        row += 1

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 17: DISPLAY - RISK-REWARD CALCULATOR TABLE
// ═══════════════════════════════════════════════════════════════════════════════════

rr_data = f_calculate_risk_reward(entryPrice_rr, slPrice_rr, tpPrice_rr, accountSize, riskPercent)
rrGood = rr_data.is_valid and rr_data.rr_ratio >= minRR

var rr_table = table.new(position.top_right, 2, 8, border_width=1, frame_width=2)

if showRRTable and barstate.islast
    table.cell(rr_table, 0, 0, "RISK-REWARD CALC", text_color=color.white, bgcolor=color.new(color.purple, 0), text_size=size.small)
    table.cell(rr_table, 1, 0, "", bgcolor=color.new(color.purple, 0))
    
    if not rr_data.is_valid
        table.cell(rr_table, 0, 1, "Status", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 1, "Set Entry/SL/TP ⤴", text_color=color.orange, text_size=size.small)
    else
        table.cell(rr_table, 0, 1, "Direction", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 1, rr_data.is_long ? "LONG 📈" : "SHORT 📉", text_color=rr_data.is_long ? color.green : color.red, text_size=size.small)
        
        table.cell(rr_table, 0, 2, "R:R Ratio", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 2, str.tostring(rr_data.rr_ratio, "#.##") + " : 1", text_color=rrGood ? color.green : color.red, text_size=size.small)
        
        table.cell(rr_table, 0, 3, "Risk Amount", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 3, "$" + str.tostring(rr_data.risk_amount, "#.##"), text_color=color.white, text_size=size.small)
        
        table.cell(rr_table, 0, 4, "Position Size", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 4, str.tostring(rr_data.position_size, "#.####"), text_color=color.white, text_size=size.small)
        
        table.cell(rr_table, 0, 5, "Risk/Unit", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 5, str.tostring(rr_data.risk_per_unit, "#.####"), text_color=color.white, text_size=size.small)
        
        table.cell(rr_table, 0, 6, "Reward/Unit", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 6, str.tostring(rr_data.reward_per_unit, "#.####"), text_color=color.white, text_size=size.small)
        
        table.cell(rr_table, 0, 7, "Verdict", text_color=color.gray, text_size=size.small)
        table.cell(rr_table, 1, 7, rrGood ? "GOOD SETUP ✅" : "SKIP ❌", text_color=color.white, bgcolor=rrGood ? color.new(color.green, 20) : color.new(color.red, 20), text_size=size.small)

f_draw_rr_lines()

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 18: ALERTS & SIGNALS
// ═══════════════════════════════════════════════════════════════════════════════════

// Alert signals
alertcondition(blalert.bullish_bos, title="Bullish BOS", message="Bullish Break of Structure Detected!")
alertcondition(blalert.bullish_choch, title="Bullish CHOCH", message="Bullish Change of Character Detected!")
alertcondition(blalert.bullish_chochplus, title="Bullish CHOCH+", message="Bullish Change of Character Plus Detected!")
alertcondition(blalert.equal_low, title="EQL Detected", message="Equal Low Signal - Potential Support!")
alertcondition(blalert.fvg_signal, title="Bullish FVG", message="Bullish Fair Value Gap Detected!")
alertcondition(blalert.ob_signal, title="Bullish OB", message="Bullish Order Block Formed!")
alertcondition(blalert.zone_signal, title="Accumulation Zone", message="Accumulation Zone Detected!")

alertcondition(bralert.bearish_bos, title="Bearish BOS", message="Bearish Break of Structure Detected!")
alertcondition(bralert.bearish_choch, title="Bearish CHOCH", message="Bearish Change of Character Detected!")
alertcondition(bralert.bearish_chochplus, title="Bearish CHOCH+", message="Bearish Change of Character Plus Detected!")
alertcondition(bralert.equal_high, title="EQH Detected", message="Equal High Signal - Potential Resistance!")
alertcondition(bralert.fvg_signal, title="Bearish FVG", message="Bearish Fair Value Gap Detected!")
alertcondition(bralert.ob_signal, title="Bearish OB", message="Bearish Order Block Formed!")
alertcondition(bralert.zone_signal, title="Distribution Zone", message="Distribution Zone Detected!")

alertcondition(rrGood, title="Good R:R Setup", message="R:R ratio meets your minimum requirement! Ready to Trade!")

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 19: PLOT & BAR COLORING
// ═══════════════════════════════════════════════════════════════════════════════════

p_css = plotcandle_bool ? i_ms_up_BOS : na
b_css = barcolor_bool ? i_ms_up_BOS : na
w_css = plotcandle_bool ? color.rgb(120, 123, 134, 50) : na

plotcandle(open, high, low, close, color=p_css, wickcolor=w_css, bordercolor=p_css, editable=false)
barcolor(b_css, editable=false)

// ═══════════════════════════════════════════════════════════════════════════════════
// SECTION 20: FOOTER
// ═══════════════════════════════════════════════════════════════════════════════════

if barstate.isfirst
    var footer_table = table.new(position.bottom_right, 1, 1, bgcolor=color.new(#363a45, 100))
    table.cell(footer_table, 0, 0, "© Guardeer PRO v6 | Risk-Reward Calculator Integrated", text_color=color.gray, text_halign=text.align_center, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════════
// END OF SCRIPT
// ═══════════════════════════════════════════════════════════════════════════════════
